{
  "name": "Cartopia",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingTargetRadius": 1024,
        "StreamingMinRadius": 256
      },
      "Ground": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [2048, 16, 2048],
          "CFrame": { "CFrame": { "position": [0, -12, 0], "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]] } },
          "Color": [0.549, 0.604, 0.263],
          "Material": "SmoothPlastic",
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "CFrame": { "CFrame": { "position": [0, 0.5, -10], "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]] } },
          "Color": [0.85, 0.85, 0.85],
          "Material": "SmoothPlastic",
          "TopSurface": "Smooth",
          "Duration": 0,
          "Transparency": 1,
          "CanCollide": false
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2,
        "GlobalShadows": true,
        "Technology": "ShadowMap",
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0.4
      }
    },
    "HttpService": {
      "$className": "HttpService",
      "$properties": {
        "HttpEnabled": true
      }
    },
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "Loading": { "$path": "src/first" }
    },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    }
  }
}
