function ____exports.carSource(car)
    if __truthy(car.season) then
        return {
            icon = "🏁",
            text = ("Season " .. tostring(car.season)) .. " prize"
        }
    end
    if car.secret then
        return {icon = "🧩", text = "Crate pieces"}
    end
    if car.pack then
        return {icon = "💳", text = "Car pack"}
    end
    if car.rescueOnly then
        local spot = __TS__ArraySort(
            __TS__ArrayFilter(
                ____exports.RESCUE_SPOTS,
                function(____, sp) return __TS__ArraySome(
                    sp.cars,
                    function(____, c) return c.model == car.id end
                ) end
            ),
            function(____, a, b) return a.unlockLevel - b.unlockLevel end
        )[1]
        return {icon = "🔧", text = if spot then "Rusty's · " .. spot.name else "Rusty's"}
    end
    if __truthy(car.bucks) then
        return {
            icon = "🚘",
            text = "Showroom · 💎" .. tostring(car.bucks)
        }
    end
    return {
        icon = "🚘",
        text = "Showroom · Lv " .. tostring(car.unlockLevel)
    }
end
